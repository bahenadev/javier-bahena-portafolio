---
const skills = [
  "Java 17",
"Spring Boot 3",
"API REST",
"Node.js",
"React",
"MySQL",
"Docker",
"Git/GitHub",
"AWS"
];
---

<section class="pt-12 pb-16 md:pt-20 md:pb-24 border-b border-slate-800/50">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-sm font-medium mb-6">
        <span class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></span>
        Disponible para nuevos retos
    </div>

    <h1 class="text-5xl md:text-7xl font-bold text-white tracking-tight mb-6">
        Javier <span class="text-slate-500">Bahena</span> <span class="text-slate-600">Ocampo</span>
    </h1>

    <p class="text-xl md:text-2xl text-slate-400 max-w-2xl leading-relaxed mb-4">
        Desarrollador Full Stack · Java | React | Node.js
    </p>

    <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-slate-500 mb-8">
        <!-- Desktop Phone: tel link -->
        <a href="tel:+527226679156" class="hidden md:flex items-center gap-1.5 hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            722 667 9156
        </a>
        <!-- Mobile Phone: tel link -->
        <a href="tel:+527226679156" class="md:hidden flex items-center gap-1.5 hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            722 667 9156
        </a>
        <!-- Desktop Email: copy to clipboard -->
        <button
            onclick="
                navigator.clipboard.writeText('javierbahenadev@gmail.com');
                const btn = this;
                const copy = btn.querySelector('.hero-copy');
                const check = btn.querySelector('.hero-check');
                copy.classList.add('hidden');
                check.classList.remove('hidden');
                setTimeout(() => {
                    copy.classList.remove('hidden');
                    check.classList.add('hidden');
                }, 2000);
            "
            class="hidden md:flex items-center gap-1.5 hover:text-white transition-colors cursor-pointer"
        >
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            javierbahenadev@gmail.com
            <svg class="hero-copy w-3.5 h-3.5 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <svg class="hero-check w-3.5 h-3.5 text-green-400 hidden flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </button>
        <!-- Mobile Email: mailto -->
        <a href="mailto:javierbahenadev@gmail.com" class="md:hidden flex items-center gap-1.5 hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            javierbahenadev@gmail.com
        </a>
        <span class="flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 8-8 14-8 14s-8-6-8-14a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            Toluca, Méx.
        </span>
        <span class="flex items-center gap-1.5 text-indigo-400">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 7-7 7 7"/><path d="M12 19V5"/></svg>
            Dispuesto a reubicación
        </span>
    </div>

    <div class="flex flex-wrap gap-4 mb-12">
        <a
            href="https://linkedin.com/in/bahenadev"
            target="_blank"
            class="bg-indigo-600 hover:bg-indigo-500 text-white px-6 py-3 rounded-lg font-medium transition-colors flex items-center gap-2"
        >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
            Hablemos por LinkedIn
        </a>

        <a
            href="https://github.com/bahenadev"
            target="_blank"
            class="bg-slate-900 hover:bg-slate-800 border border-slate-700 hover:border-slate-600 text-white px-6 py-3 rounded-lg font-medium transition-colors flex items-center gap-2"
        >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
            Ver código en GitHub
        </a>

        <a
            href="/cv-javier-bahena.pdf"
            download
            class="bg-slate-900 hover:bg-slate-800 border border-slate-700 hover:border-slate-600 text-white px-6 py-3 rounded-lg font-medium transition-colors flex items-center gap-2"
        >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
            Descargar CV
        </a>
    </div>

    <div class="flex flex-wrap gap-2">
        {skills.map(skill => (
            <span class="px-3 py-1 bg-slate-900/50 border border-slate-800 rounded-md text-sm text-slate-400">
                {skill}
            </span>
        ))}
    </div>
</section>
