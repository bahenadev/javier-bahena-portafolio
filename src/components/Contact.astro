---
---

<section id="contacto" class="py-16 md:py-24 border-t border-slate-800/50">
  <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">Contacto</h2>
  <p class="text-slate-400 text-lg max-w-2xl mb-12 leading-relaxed">
    ¿Tienes un proyecto en mente o una oportunidad laboral? Estoy disponible para nuevos retos. Hablemos.
  </p>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">
    <!-- Desktop: copy to clipboard -->
    <button
      onclick="
        navigator.clipboard.writeText('javierbahenadev@gmail.com');
        const btn = this;
        const copy = btn.querySelector('.contact-copy');
        const check = btn.querySelector('.contact-check');
        copy.classList.add('hidden');
        check.classList.remove('hidden');
        setTimeout(() => {
          copy.classList.remove('hidden');
          check.classList.add('hidden');
        }, 2000);
      "
      class="hidden md:flex bg-slate-900/40 border border-slate-800 rounded-xl p-5 hover:bg-slate-800/40 hover:border-indigo-500/50 transition-all duration-300 items-start gap-4 group cursor-pointer text-left w-full"
    >
      <span class="text-indigo-400 mt-0.5 flex-shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
      </span>
      <div class="flex-1">
        <p class="text-slate-500 text-xs uppercase tracking-wider mb-1">Email</p>
        <div class="flex items-center gap-2 min-w-0">
          <p class="text-white font-medium group-hover:text-indigo-400 transition-colors break-all">javierbahenadev@gmail.com</p>
          <svg class="contact-copy w-4 h-4 text-slate-600 group-hover:text-indigo-400 transition-colors flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          <svg class="contact-check w-4 h-4 text-green-400 hidden flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </div>
      </div>
    </button>

    <!-- Mobile: mailto -->
    <a
      href="mailto:javierbahenadev@gmail.com"
      class="md:hidden bg-slate-900/40 border border-slate-800 rounded-xl p-5 hover:bg-slate-800/40 hover:border-indigo-500/50 transition-all duration-300 flex items-start gap-4 group"
    >
      <span class="text-indigo-400 mt-0.5 flex-shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
      </span>
      <div>
        <p class="text-slate-500 text-xs uppercase tracking-wider mb-1">Email</p>
        <p class="text-white font-medium group-hover:text-indigo-400 transition-colors break-all">javierbahenadev@gmail.com</p>
      </div>
    </a>

    <a href="tel:+527226679156" class="bg-slate-900/40 border border-slate-800 rounded-xl p-5 hover:bg-slate-800/40 hover:border-indigo-500/50 transition-all duration-300 flex items-start gap-4 group">
      <span class="text-indigo-400 mt-0.5 flex-shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      </span>
      <div>
        <p class="text-slate-500 text-xs uppercase tracking-wider mb-1">Teléfono</p>
        <p class="text-white font-medium group-hover:text-indigo-400 transition-colors">722 667 9156</p>
      </div>
    </a>

    <div class="bg-slate-900/40 border border-slate-800 rounded-xl p-5 flex items-start gap-4">
      <span class="text-indigo-400 mt-0.5 flex-shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 8-8 14-8 14s-8-6-8-14a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
      </span>
      <div>
        <p class="text-slate-500 text-xs uppercase tracking-wider mb-1">Ubicación</p>
        <p class="text-white font-medium">Toluca, Méx.</p>
      </div>
    </div>
  </div>

  <div class="bg-slate-900/40 border border-slate-800 rounded-xl p-6">
    <p class="text-white font-semibold text-lg mb-2">¿Listo para colaborar?</p>
    <p class="text-slate-400 text-sm mb-6">Rellena el formulario y te responderé lo antes posible.</p>
    <form
      name="contacto"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      class="space-y-4"
    >
      <input type="hidden" name="form-name" value="contacto" />
      <div class="hidden" aria-hidden="true">
        <input name="bot-field" />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <input
          type="text"
          name="nombre"
          placeholder="Tu nombre"
          required
          class="bg-slate-950 border border-slate-800 rounded-lg px-4 py-2.5 text-sm text-white placeholder-slate-600 focus:outline-none focus:border-indigo-500 transition-colors"
        />
        <input
          type="email"
          name="email"
          placeholder="Tu email"
          required
          class="bg-slate-950 border border-slate-800 rounded-lg px-4 py-2.5 text-sm text-white placeholder-slate-600 focus:outline-none focus:border-indigo-500 transition-colors"
        />
      </div>
      <textarea
        name="mensaje"
        rows="4"
        placeholder="Cuéntame sobre tu proyecto u oportunidad..."
        required
        class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-2.5 text-sm text-white placeholder-slate-600 focus:outline-none focus:border-indigo-500 transition-colors resize-none"
      ></textarea>

      <div class="flex items-center gap-4">
        <button
          type="submit"
          class="bg-indigo-600 hover:bg-indigo-500 text-white px-6 py-2.5 rounded-lg font-medium text-sm transition-colors flex items-center gap-2"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          Enviar mensaje
        </button>
        <p class="form-msg text-sm text-slate-500 hidden"></p>
      </div>
    </form>
  </div>
</section>

<script>
  document.querySelector('form[name="contacto"]')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const msg = form.querySelector('.form-msg');
    const btn = form.querySelector('button');

    btn.disabled = true;
    btn.innerHTML = 'Enviando...';
    msg.classList.add('hidden');

    try {
      const res = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(new FormData(form)).toString(),
      });
      if (res.ok) {
        msg.textContent = '¡Mensaje enviado! Te responderé pronto.';
        msg.classList.remove('hidden', 'text-red-400');
        msg.classList.add('text-green-400');
        form.reset();
      } else {
        throw new Error();
      }
    } catch {
      msg.textContent = 'Error al enviar. Intenta a mi email directo.';
      msg.classList.remove('hidden', 'text-green-400');
      msg.classList.add('text-red-400');
    }
    btn.disabled = false;
    btn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg> Enviar mensaje';
  });
</script>
