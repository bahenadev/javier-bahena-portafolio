---
const projects = [
    {
        title: "Listo Broker",
        description: "SaaS CRM inmobiliario con arquitectura Multi-tenant (multi-inquilino). Diseñado para escalar operaciones de múltiples agencias, centralizando la gestión de inventario y prospectos en una plataforma unificada.",
        tech: ["Next.js", "NestJS", "Supabase", "TypeScript"],
        link: "https://listodev.com" 
    },
    {
        title: "Sistema de Microcréditos",
        description: "Solución financiera robusta basada en una arquitectura de microservicios. Gestiona el ciclo completo de préstamos y cobranza con alta disponibilidad y consistencia de datos a nivel empresarial.",
        tech: ["Java", "Spring Boot", "Microservices", "Oracle Database"],
        link: "#"
    },
    {
        title: "Inmolegia",
        description: "Plataforma para la administración integral de activos inmobiliarios. Facilita el control operativo y comercial de la agencia, optimizando los tiempos de respuesta y recuperación de propiedades.",
        tech: ["PHP", "JavaScript", "CSS/HTML", "SaaS Architecture"],
        link: "#" 
    },
    {
        title: "MuebleArte",
        description: "E-commerce especializado en el sector de mobiliario. Implementa un flujo completo de compra, desde la navegación por catálogo hasta la gestión de inventarios y pedidos en backend.",
        tech: ["Java", "Spring Boot", "MySQL", "Bootstrap", "JS"],
        link: "#"
    }
];
---

<section class="py-16 md:py-24">
    <h2 class="text-3xl md:text-4xl font-bold text-white mb-12">Experiencia & Proyectos</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {projects.map(project => (
            <a class="group bg-slate-900/40 border border-slate-800 rounded-2xl p-6 hover:bg-slate-800/40 hover:border-indigo-500/50 transition-all duration-300 flex flex-col h-full" href={project.link} target="_blank">
                <h3 class="text-xl font-bold text-white mb-3 group-hover:text-indigo-400 transition-colors">
                    {project.title}
                </h3>
                <p class="text-slate-400 text-sm leading-relaxed mb-6 flex-grow">
                    {project.description}
                </p>
                <div class="flex flex-wrap gap-2 mt-auto">
                    {project.tech.map(tech => (
                        <span class="text-[11px] uppercase tracking-wider font-semibold bg-slate-950 border border-slate-800 px-2 py-1 rounded text-slate-300">
                            {tech}
                        </span>
                    ))}
                </div>
            </a>
        ))}
    </div>
</section>