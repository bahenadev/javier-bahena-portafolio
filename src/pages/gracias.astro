---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Gracias | Javier Bahena">
  <main class="max-w-5xl mx-auto px-6 min-h-screen flex flex-col items-center justify-center text-center">
    <span class="text-7xl md:text-8xl font-black text-indigo-500/20 select-none">¡Gracias!</span>
    <h1 class="text-3xl md:text-4xl font-bold text-white mt-6 mb-4">
      Mensaje enviado
    </h1>
    <p class="text-slate-400 text-lg max-w-md mb-10 leading-relaxed">
      Te responderé lo antes posible.
    </p>
    <a
      href="/"
      class="bg-indigo-600 hover:bg-indigo-500 text-white px-6 py-3 rounded-lg font-medium transition-colors inline-flex items-center gap-2"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 7-7 7 7"/><path d="M12 19V5"/></svg>
      Volver al inicio
    </a>
  </main>
</Layout>
